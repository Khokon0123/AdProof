# Copy to .env and fill in. NEVER commit .env. Names only here, no values.

# LIVE (real Gemini) or MOCK (scripted model, offline, clearly labeled in every reply)
ADPROOF_EXECUTION_MODE=LIVE

# Gemini (https://aistudio.google.com -> Get API key). Pick a current Flash model with image input.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Sentry (create a Python project, copy its client DSN). Optional: AdProof works without it.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=1.0

# Agent identities: run `python -m scripts.init_identities` to generate these once (do not rotate).
ORCHESTRATOR_SEED=
VERIFIER_SEED=
REMEDIATOR_SEED=

# Where the public demo assets live (raw GitHub URL of data/fixtures after you push).
ADPROOF_FIXTURE_BASE_URL=https://raw.githubusercontent.com/Khokon0123/AdProof/main/data/fixtures
# Only these hosts are fetched. Set ADPROOF_ALLOW_PUBLIC_HOSTS=1 to allow any public HTTPS host.
ADPROOF_ALLOWED_HOSTS=raw.githubusercontent.com
ADPROOF_ALLOW_PUBLIC_HOSTS=0

# Limits
ADPROOF_MAX_MODEL_CALLS=20
ADPROOF_AUDIT_DEADLINE_S=180
# 1 = reuse image-only observations for the same image hash (the Sentry-measured improvement)
ADPROOF_INSPECTION_CACHE=1
ADPROOF_STATE_DB=runtime/adproof_state.sqlite3
