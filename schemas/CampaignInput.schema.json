{
  "$defs": {
    "CampaignContext": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audience"
        },
        "jurisdiction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jurisdiction"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "platform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform"
        },
        "product_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Category"
        }
      },
      "title": "CampaignContext",
      "type": "object"
    },
    "Creative": {
      "additionalProperties": false,
      "properties": {
        "ad_copy": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Ad Copy",
          "type": "string"
        },
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        }
      },
      "required": [
        "ad_copy"
      ],
      "title": "Creative",
      "type": "object"
    },
    "EvidenceDocument": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source_type": {
          "default": "html",
          "enum": [
            "html",
            "text"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "name",
        "url"
      ],
      "title": "EvidenceDocument",
      "type": "object"
    },
    "ProductContext": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "variant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant"
        }
      },
      "title": "ProductContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "campaign_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/CampaignContext",
      "default": {
        "audience": null,
        "jurisdiction": null,
        "language": null,
        "platform": null,
        "product_category": null
      }
    },
    "creative": {
      "$ref": "#/$defs/Creative"
    },
    "creative_version": {
      "minimum": 1,
      "title": "Creative Version",
      "type": "integer"
    },
    "evidence_documents": {
      "items": {
        "$ref": "#/$defs/EvidenceDocument"
      },
      "maxItems": 3,
      "title": "Evidence Documents",
      "type": "array"
    },
    "landing_page_url": {
      "title": "Landing Page Url",
      "type": "string"
    },
    "product_context": {
      "$ref": "#/$defs/ProductContext",
      "default": {
        "currency": null,
        "model": null,
        "quantity": null,
        "variant": null
      }
    },
    "repair_mode": {
      "default": "audit_only",
      "enum": [
        "audit_only",
        "repair_once"
      ],
      "title": "Repair Mode",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "campaign_id",
    "creative_version",
    "creative",
    "landing_page_url"
  ],
  "title": "CampaignInput",
  "type": "object"
}
